// Rebuilds Glass Dash from the pasted glass-dash-part-NN.txt files.
// Put this file and every part in one folder, then run:  node unpack.mjs [target folder]
// The target defaults to ./glass-dash. Nothing is written unless every check passes.
import fs from 'node:fs';
import path from 'node:path';
import zlib from 'node:zlib';
import crypto from 'node:crypto';
import { fileURLToPath } from 'node:url';

const sha = (b) => crypto.createHash('sha256').update(b).digest('hex');
const here = path.dirname(fileURLToPath(import.meta.url));
const target = path.resolve(process.argv[2] || 'glass-dash');
const fail = (m) => { console.error(`\nSTOPPED: ${m}`); process.exit(1); };

const parts = fs.readdirSync(here).filter((f) => /^glass-dash-part-\d+\.txt$/.test(f)).sort();
if (!parts.length) fail(`no glass-dash-part-NN.txt files next to unpack.mjs (${here})`);
let total = 0, bundleHash = '', b64 = '';
for (const f of parts) {
  const text = fs.readFileSync(path.join(here, f), 'utf8').replace(/^﻿/, '');
  const hdr = (re) => (text.match(re) || [])[1];
  const partHash = hdr(/^# part-sha256 (\w+)/m);
  const body = text.split(/\r?\n/).filter((l) => !l.startsWith('#')).join('').replace(/\s+/g, '');
  if (!partHash) fail(`${f}: header lines missing — copy the whole file, including the lines starting with #`);
  if (sha(body) !== partHash) fail(`${f} does not match its checksum — copy and paste that part again`);
  total = Number(hdr(/^# GLASS-DASH BUNDLE part \d+ of (\d+)/m));
  bundleHash = hdr(/^# bundle-sha256 (\w+)/m);
  b64 += body;
  console.log(`ok  ${f}`);
}
if (parts.length !== total) fail(`found ${parts.length} parts but the bundle has ${total}`);

const raw = zlib.gunzipSync(Buffer.from(b64, 'base64'));
if (sha(raw) !== bundleHash) fail('the joined bundle does not match its checksum');
const n = raw.readUInt32BE(0);
const manifest = JSON.parse(raw.subarray(4, 4 + n).toString('utf8'));
let off = 4 + n;
for (const { p, n: size, h } of manifest) {
  const b = raw.subarray(off, off + size);
  off += size;
  if (sha(b) !== h) fail(`${p} is damaged`);
  const dest = path.join(target, p);
  if (!dest.startsWith(target + path.sep)) fail(`unsafe path ${p}`);
  fs.mkdirSync(path.dirname(dest), { recursive: true });
  fs.writeFileSync(dest, b);
}
console.log(`\nDone: ${manifest.length} files written to ${target}\nNext:  cd "${target}"  then  npm run demo`);
