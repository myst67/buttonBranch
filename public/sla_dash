   "shared_code": {
    "js": "var SLA_SEV = { critical: '#ef4444', high: '#f59e0b', medium: '#d946ef', low: '#a3e635', info: '#38bdf8', unknown: '#94a3b8' };\nfunction slaEsc(s) { return String(s === null || s === undefined ? '–' : s).replace(/[&<>\"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;' }[c]; }); }\nfunction slaMsg(t) { return '<div class=\"sla-msg\">' + slaEsc(t) + '</div>'; }\nfunction slaSize(ctx) { var s = (ctx && ctx.size) || KPI.size || {}; return { w: Math.max(240, s.w || root.clientWidth || 400), h: Math.max(160, s.h || root.clientHeight || 260) }; }\nfunction slaNice(v) { if (!(v > 0)) return 4; var raw = v / 4, p = Math.pow(10, Math.floor(Math.log10(raw))), f = raw / p; var step = (f <= 1 ? 1 : f <= 2 ? 2 : f <= 2.5 ? 2.5 : f <= 5 ? 5 : 10) * p; return Math.ceil(v / step) * step; }\nfunction slaNum(v) { return Math.round(v * 10) / 10; }\nfunction slaClicks(field) {\nroot.addEventListener('click', function (e) {\nvar t = e.target; while (t && t !== root && !(t.getAttribute && t.getAttribute('data-k'))) t = t.parentNode;\nif (t && t !== root) KPI.filter(t.getAttribute('data-f') || field, t.getAttribute('data-k'));\n});\n}\nfunction slaLine(res, ctx, xTitle) {\nif (!res || res.error) return slaMsg(res ? res.error : 'No data');\nvar g = (res.groups || []).filter(function (x) { return x.value !== null && x.value !== undefined && !x.other && x.key[0] !== null; });\ng.sort(function (a, b) { return b.value - a.value; });\nif (!g.length) return slaMsg('No data for this selection');\nvar sz = slaSize(ctx), W = sz.w, H = sz.h, L = 46, R = 12, T = 10, B = 74;\nvar pw = W - L - R, ph = H - T - B, max = slaNice(g[0].value * 1.05), n = g.length;\nvar x = function (i) { return L + ((i + 0.5) * pw) / n; };\nvar y = function (v) { return T + ph - (v / max) * ph; };\nvar s = '<svg class=\"sla-svg\" viewBox=\"0 0 ' + W + ' ' + H + '\" width=\"' + W + '\" height=\"' + H + '\">';\nfor (var k = 0; k <= 4; k++) {\nvar v = (max * k) / 4, yy = y(v);\ns += '<line class=\"grid\" x1=\"' + L + '\" x2=\"' + (W - R) + '\" y1=\"' + yy + '\" y2=\"' + yy + '\"/><text class=\"ax\" x=\"' + (L - 6) + '\" y=\"' + (yy + 4) + '\" text-anchor=\"end\">' + slaNum(v) + '</text>';\n}\ns += '<text class=\"ax t\" transform=\"translate(12 ' + (T + ph / 2) + ') rotate(-90)\" text-anchor=\"middle\">In Minutes</text>';\nvar pts = g.map(function (p, i) { return x(i) + ',' + y(p.value); }).join(' ');\ns += '<polyline class=\"ln\" points=\"' + pts + '\"/>';\ng.forEach(function (p, i) {\nvar lab = p.label || p.key[0];\ns += '<g class=\"pt\" data-k=\"' + slaEsc(p.key[0]) + '\"><circle cx=\"' + x(i) + '\" cy=\"' + y(p.value) + '\" r=\"3.5\"><title>' + slaEsc(lab) + ': ' + slaNum(p.value) + ' min</title></circle>';\ns += '<text class=\"ax\" transform=\"translate(' + x(i) + ' ' + (T + ph + 10) + ') rotate(-40)\" text-anchor=\"end\">' + slaEsc(String(lab).slice(0, 16)) + '</text></g>';\n});\ns += '<text class=\"ax t\" x=\"' + (L + pw / 2) + '\" y=\"' + (H - 4) + '\" text-anchor=\"middle\">' + slaEsc(xTitle) + '</text></svg>';\nreturn '<div class=\"sla\">' + s + '</div>';\n}\nfunction slaSankey(res, ctx) {\nif (!res || res.error) return slaMsg(res ? res.error : 'No data');\nvar g = (res.groups || []).filter(function (x) { return x.value > 0 && !x.other && x.key[0] !== null && x.key[1] !== null; });\nif (!g.length) return slaMsg('No data for this selection');\nvar left = {}, right = {}, total = 0;\ng.forEach(function (p) {\nvar a = String(p.key[0]), b = String(p.key[1]);\nleft[a] = left[a] || { key: a, label: (p.labels && p.labels[0]) || a, v: 0, off: 0 };\nright[b] = right[b] || { key: b, label: (p.labels && p.labels[1]) || b, v: 0, off: 0 };\nleft[a].v += p.value; right[b].v += p.value; total += p.value;\n});\nvar L = Object.keys(left).map(function (k) { return left[k]; }).sort(function (a, b) { return b.v - a.v; });\nvar Rn = Object.keys(right).map(function (k) { return right[k]; }).sort(function (a, b) { return Number(b.key) - Number(a.key) || (a.key < b.key ? -1 : 1); });\nvar sz = slaSize(ctx), W = sz.w, H = sz.h, T = 8, B = 8, NW = 12, gap = 4;\nvar lx = 8, rx = W - 8 - NW;\nvar scale = function (nodes) { return (H - T - B - gap * (nodes.length - 1)) / total; };\nvar sl = scale(L), sr = scale(Rn), k = Math.min(sl, sr);\nvar place = function (nodes) { var yy = T; nodes.forEach(function (nd) { nd.y = yy; nd.h = Math.max(1, nd.v * k); yy += nd.h + gap; }); };\nplace(L); place(Rn);\nvar colour = {}; L.forEach(function (nd, i) { colour[nd.key] = KPI.color(i); });\nvar sevColour = function (nd) { return SLA_SEV[String(nd.label).toLowerCase()] || KPI.color(Rn.indexOf(nd) + 3); };\ng.sort(function (a, b) { return L.indexOf(left[String(a.key[0])]) - L.indexOf(left[String(b.key[0])]) || Rn.indexOf(right[String(a.key[1])]) - Rn.indexOf(right[String(b.key[1])]); });\nvar s = '<svg class=\"sla-svg\" viewBox=\"0 0 ' + W + ' ' + H + '\" width=\"' + W + '\" height=\"' + H + '\">';\ng.forEach(function (p) {\nvar a = left[String(p.key[0])], b = right[String(p.key[1])], w = Math.max(1, p.value * k);\nvar y0 = a.y + a.off + w / 2, y1 = b.y + b.off + w / 2, x0 = lx + NW, x1 = rx, mx = (x0 + x1) / 2;\na.off += w; b.off += w;\ns += '<path class=\"band\" data-f=\"assignee_name\" data-k=\"' + slaEsc(a.key) + '\" d=\"M' + x0 + ' ' + y0 + ' C' + mx + ' ' + y0 + ' ' + mx + ' ' + y1 + ' ' + x1 + ' ' + y1 + '\" stroke=\"' + colour[a.key] + '\" stroke-width=\"' + w + '\"><title>' + slaEsc(a.label) + ' → ' + slaEsc(b.label) + ': ' + p.value + '</title></path>';\n});\nL.forEach(function (nd) {\ns += '<g data-f=\"assignee_name\" data-k=\"' + slaEsc(nd.key) + '\"><rect x=\"' + lx + '\" y=\"' + nd.y + '\" width=\"' + NW + '\" height=\"' + nd.h + '\" fill=\"' + colour[nd.key] + '\"/>';\nif (nd.h >= 10) s += '<text class=\"lbl\" x=\"' + (lx + NW + 6) + '\" y=\"' + (nd.y + nd.h / 2 + 4) + '\">' + slaEsc(nd.label) + ' (' + nd.v + ')</text>';\ns += '</g>';\n});\nRn.forEach(function (nd) {\ns += '<g data-f=\"severity\" data-k=\"' + slaEsc(nd.key) + '\"><rect x=\"' + rx + '\" y=\"' + nd.y + '\" width=\"' + NW + '\" height=\"' + nd.h + '\" fill=\"' + sevColour(nd) + '\"/>';\nif (nd.h >= 10) s += '<text class=\"lbl\" x=\"' + (rx - 6) + '\" y=\"' + (nd.y + nd.h / 2 + 4) + '\" text-anchor=\"end\">' + slaEsc(nd.label) + ' (' + nd.v + ')</text>';\ns += '</g>';\n});\nreturn '<div class=\"sla\">' + s + '</svg></div>';\n}"
