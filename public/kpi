    const mx = Math.max(...vals), mn = Math.min(...vals), rng = mx - mn || 1;
    const pts = vals.map((v, i) => `${((i / Math.max(vals.length - 1, 1)) * 90).toFixed(1)},${(28 - ((v - mn) / rng) * 26).toFixed(1)}`).join(' ');
    return `<svg viewBox="0 0 90 30" preserveAspectRatio="none" width="90" height="30" style="overflow:visible" aria-hidden="true"><polyline points="${pts}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/></svg>`;
  }

  // ---------------------------------------------------------------- lifecycle
  const onResize = debounce(() => { if (S.tab === 'overview') renderSelection(); else renderCompare(); }, 150);
  window.addEventListener('resize', onResize);
  renderShell();
  load();
  if (S.tab === 'compare') loadCompare();
  return () => {
    window.removeEventListener('resize', onResize);
    closePopover();
    if (raf) cancelAnimationFrame(raf);
  };
}
