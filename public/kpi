// The analytics hub (/analytics/kpi/:metric), as Platform X's analytics hub page:
//   Overview — the KPI's value on a focal date and its change since the start of the navigator's
//     context; the navigator (about two years of the aggregation's steps, a brush selecting the
//     range shown below it) with its range picker and aggregation; the range's statistics; the
//     toolbar (Group by drawer, breakdown search, value filters, point labels, median, confidence
//     band, forecast, Score / Δ / Δ% / YOY, line / area / bar, close); and the main chart, one
//     series per value while a breakdown is expanded.
//   Compare — the KPI split across one breakdown's segments over a range, each against the period
//     before (dashed), with legend chips and a table of each segment's aggregates.
// Opened from the sidebar (incidents created) or from a dashboard widget whose Analytics hub is on
// (?agg= and ?date= carry the widget's aggregation and the clicked date). Every number comes from
// POST /api/dash/query.

import { h, mount, debounce } from '../lib/dom.js';
import { icon } from '../lib/icons.js';
import { get, post, errorText } from '../lib/api.js';
import { setQuery, navigate } from '../lib/router.js';
import { emptyState, errorBox, loading } from '../lib/ui.js';
import { analyticsChart, colorsFor } from '/shared/charts.js';
import { formatValue, esc } from '/shared/format.js';
import { dayKey } from '/shared/time.js';
import { SEVERITIES } from '/shared/canonical.js';
import {
  ensureCss, AGG_OPTIONS, aggOption, seriesQuery, aggSelect, datePicker, openPopover, closePopover,
  shiftIso, longDate, shortDate,
} from '../lib/analytics.js';

const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const ISO_DAY = /^\d{4}-\d{2}-\d{2}$/;
const FOCAL_PAD_DAYS = 15;
// the navigator's context, and the default selection inside it (the last N steps), per step
const CONTEXT_DAYS = { day: 730, week: 730, month: 1095, quarter: 1460 };
const SEL_BUCKETS = { day: 15, week: 12, month: 6, quarter: 4 };
const MEASURE_COLOR = { score: 'var(--series-1)', delta: 'var(--series-2)', pct: 'var(--series-3)', yoy: 'var(--series-7)' };

const isNum = (v) => v !== null && v !== undefined && Number.isFinite(v);
const svg = (paths, extra = '') => h('span', { html: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" ${extra}>${paths}</svg>` });
const ICONS = {
  labels: () => svg('<path d="M20.5 13.5l-7 7a2 2 0 0 1-2.8 0l-7.2-7.2V4h9.3l7.7 7.7a1.3 1.3 0 0 1 0 1.8z"/><circle cx="8" cy="8" r="1.4"/>'),
  median: () => svg('<path d="M2 12h4M18 12h4"/><rect x="6" y="8" width="12" height="8" rx="1.5"/><path d="M12.5 8v8" stroke-width="2.6"/>'),
  band: () => svg('<rect x="3" y="7" width="18" height="10" rx="2" fill="currentColor" stroke="none" opacity=".2"/><path d="M3 8h18M3 16h18" stroke-dasharray="3 2.5"/><path d="M3 12h18"/>'),
  forecast: () => svg('<path d="M3 16l5-4 3 2"/><path d="M11 14l6-5" stroke-dasharray="3 2.5"/><path d="M14 8.5h3.5V12"/>'),
  score: () => svg('<path d="M5 16a7 7 0 1 1 14 0"/><path d="M12 16l3.5-3.5"/><circle cx="12" cy="16" r="1.2" fill="currentColor" stroke="none"/>'),
  line: () => svg('<path d="M3 16l5-5 4 3 7-8"/>'),
  area: () => svg('<path d="M3 16l5-5 4 3 7-8V20H3z" fill="currentColor" fill-opacity=".25" stroke="none"/><path d="M3 16l5-5 4 3 7-8"/>'),
  bar: () => svg('<rect x="4" y="12" width="3.6" height="8" rx="1" fill="currentColor" stroke="none"/><rect x="10.2" y="6" width="3.6" height="14" rx="1" fill="currentColor" stroke="none"/><rect x="16.4" y="9" width="3.6" height="11" rx="1" fill="currentColor" stroke="none"/>'),
  close: () => svg('<path d="M6 6l12 12M18 6L6 18"/>', 'stroke-width="2"'),
};

function mean(a) { return a.length ? a.reduce((s, x) => s + x, 0) / a.length : 0; }
function median(a) {
  if (!a.length) return 0;
  const s = [...a].sort((x, y) => x - y);
  const m = Math.floor(s.length / 2);
  return s.length % 2 ? s[m] : (s[m - 1] + s[m]) / 2;
}
function std(a, mu = mean(a)) {
  if (a.length < 2) return 0;
  return Math.sqrt(a.reduce((s, x) => s + (x - mu) ** 2, 0) / a.length);
}
/** Least-squares line through the points, carried `count` steps on (never below zero). */
function forecast(vals, count) {
  const n = vals.length;
  const mx = (n - 1) / 2, my = mean(vals);
  let num = 0, den = 0;
  for (let i = 0; i < n; i++) { num += (i - mx) * (vals[i] - my); den += (i - mx) ** 2; }
  const b = den ? num / den : 0;
  return Array.from({ length: count }, (_, k) => Math.max(0, Math.round((my - b * mx + b * (n + k)) * 10) / 10));
}
const r1 = (v) => Math.round(v * 10) / 10;
/** Change from a base as Platform X words it: a base of 0 that grew is +100 %. */
const pctFrom = (cur, base) => (base ? r1(((cur - base) / base) * 100) : cur ? 100 : 0);

export default async function kpi(container, params, query) {
  ensureCss();
  mount(container, loading());
  let metricId = params.metric;
  let hub;
  try {
    hub = await get('/api/dash/hub');
  } catch (e) {
    return mount(container, errorBox(e));
  }
  let meta = (hub.metrics || []).find((m) => m.id === metricId);
  if (!meta) return mount(container, emptyState('target', 'KPI not found', `This tenant has no metric '${metricId}'.`, h('a', { class: 'btn', href: '/dashboards' }, 'Back to dashboards')));
  const tz = hub.timezone || 'UTC';
  const dims = hub.dimensions || [];
  const dimOf = (k) => dims.find((d) => d.key === k);
  const dimLabel = (k) => dimOf(k)?.label || k;
  const fmt = (v) => formatValue(v, meta.format, { unit: meta.unit });
  const today = () => dayKey(Date.now(), tz);

  const S = {
    tab: query.get('tab') === 'compare' ? 'compare' : 'overview',
    agg: AGG_OPTIONS.some((o) => o.value === query.get('agg')) ? query.get('agg') : 'daily_sum',
    dateFrom: '', dateTo: '', focal: '',
    filters: [], // [{ dim, key, label }]: values of one breakdown OR'd, breakdowns AND'd
    groupBy: '', drawer: false, q: '',
    score: true, delta: false, pct: false, yoy: false,
    labels: false, median: false, band: false, forecast: false,
    chartType: 'area',
    hidden: new Set(),
    cmpDim: dims[0]?.key || 'severity', cmpPrev: true, cmpFrom: shiftIso(today(), -29), cmpTo: today(),
    cmpHidden: new Set(),
  };
  // a dashboard chart click deep-links a date: focus it and centre the range on it once
  const date = query.get('date');
  if (ISO_DAY.test(date || '')) {
    S.focal = date;
    S.dateFrom = shiftIso(date, -FOCAL_PAD_DAYS);
    const to = shiftIso(date, FOCAL_PAD_DAYS);
    S.dateTo = to > today() ? today() : to;
  }

  let full = []; // [{ date, to, value }] over the navigator's context
  let ctxError = null;
  let sel = [0, 0];
  let grouped = []; // [{ id, key, label, color, byDate: { date: value } }]
  let cmp = null;
  let searchHits = null;
  let seq = 0, cmpSeq = 0, loaded = false;
  const bucket = () => aggOption(S.agg).bucket;

  function filterSpecs(list) {
    const byDim = new Map();
    for (const f of list) {
      if (!byDim.has(f.dim)) byDim.set(f.dim, []);
      byDim.get(f.dim).push(f.key);
    }
    return [...byDim].map(([field, keys]) => {
      const vals = keys.filter((k) => k !== null && k !== undefined);
      if (vals.length === keys.length) return { field, op: 'in', value: vals };
      return vals.length ? { any: [{ field, op: 'in', value: vals }, { field, op: 'isNull' }] } : { field, op: 'isNull' };
    });
  }
  const pointOf = (b, p) => ({ date: dayKey(Date.parse(b.s), tz), to: dayKey(Date.parse(b.e) - 1, tz), value: isNum(p?.value) ? p.value : null });
  function rowsOf(res) {
    const dim = res.dimensions?.[0]?.key;
    const keys = (res.groups || []).map((g) => (dim === 'severity' ? String(g.label).toLowerCase() : String(g.key?.[0] ?? '(none)')));
    const colors = colorsFor(keys, dim);
    return (res.groups || []).map((g, i) => ({
      id: JSON.stringify(g.key?.[0] ?? null), key: g.key?.[0] ?? null, label: g.label, color: colors[keys[i]],
      series: (res.buckets || []).map((b, k) => pointOf(b, g.series?.[k])),
    }));
  }

  // ---------------------------------------------------------------- data
  function contextWindow() {
    const t = today();
    let from = shiftIso(t, -(CONTEXT_DAYS[bucket()] || 730));
    if (S.dateFrom && S.dateFrom < from) from = S.dateFrom;
    return seriesQuery(S.agg, { from, to: t }, tz);
  }

  async function load() {
    const my = ++seq;
    setBusy(true);
    const { agg, window } = contextWindow();
    const queries = [{ id: 'ctx', metric: metricId, vars: { window, agg }, filters: filterSpecs(S.filters) }];
    // the breakdown keeps filters on other breakdowns, not on its own (its other values stay pickable)
    if (S.groupBy) queries.push({ id: 'grp', metric: metricId, group_by: [S.groupBy], vars: { window, agg }, filters: filterSpecs(S.filters.filter((f) => f.dim !== S.groupBy)), other: false });
    try {
      const res = await post('/api/dash/query', { queries });
      if (my !== seq) return;
      const r = res.results?.ctx;
      if (!r || r.error) { full = []; ctxError = r?.error || 'No result'; }
      else {
        ctxError = null;
        full = (r.buckets || []).map((b, i) => pointOf(b, r.series?.[i]));
      }
      const g = res.results?.grp;
      grouped = S.groupBy && g && !g.error ? rowsOf(g).map((x) => ({ ...x, byDate: Object.fromEntries(x.series.map((p) => [p.date, p.value])) })) : [];
      S.hidden = new Set();
      loaded = true;
      applySelection();
    } catch (e) {
      if (my !== seq) return;
      full = [];
      ctxError = errorText(e);
    }
    setBusy(false);
    renderOverview();
  }

  const idxForIso = (iso) => {
    let idx = 0;
    for (let i = 0; i < full.length; i++) { if (full[i].date <= iso) idx = i; else break; }
    return idx;
  };
  /** The brush: the picked range, else the aggregation's default span (the last N steps). */
  function applySelection() {
    const n = full.length;
    if (!n) { sel = [0, 0]; return; }
    let a, b;
    if (S.dateFrom && S.dateTo) { a = idxForIso(S.dateFrom); b = idxForIso(S.dateTo); }
    else {
      const selN = S.agg === 'total' ? n : SEL_BUCKETS[bucket()] || n;
      a = Math.max(0, n - selN);
      b = n - 1;
    }
    a = Math.max(0, Math.min(a, n - 1));
    b = Math.max(a, Math.min(b, n - 1));
    sel = [a, b];
  }

  async function loadCompare() {
    const my = ++cmpSeq;
    setBusy(true);
    const dim = S.cmpDim;
    const o = aggOption(S.agg);
    const agg = `${{ day: 'daily', week: 'weekly', month: 'monthly', quarter: 'quarterly' }[o.bucket]}_${S.agg.endsWith('_avg') ? 'avg' : 'sum'}`;
    const days = Math.round((Date.parse(S.cmpTo) - Date.parse(S.cmpFrom)) / 86400000) + 1;
    const prevTo = shiftIso(S.cmpFrom, -1);
    const base = { metric: metricId, group_by: [dim], other: false };
    try {
      const res = await post('/api/dash/query', { queries: [
        { id: 'cur', ...base, vars: { window: { from: S.cmpFrom, to: S.cmpTo }, agg } },
        { id: 'prev', ...base, vars: { window: { from: shiftIso(prevTo, -(days - 1)), to: prevTo }, agg } },
      ] });
      if (my !== cmpSeq) return;
      const cur = res.results?.cur, prev = res.results?.prev;
      if (!cur || cur.error) cmp = { dim, dates: [], groups: [], error: cur?.error || 'No result' };
      else {
        const prevById = new Map(prev && !prev.error ? rowsOf(prev).map((g) => [g.id, g.series]) : []);
        const dates = (cur.buckets || []).map((b) => dayKey(Date.parse(b.s), tz));
        // the previous period is lined up step for step with the current one
        cmp = { dim, dates, groups: rowsOf(cur).map((g) => ({ ...g, prev: dates.map((_, i) => prevById.get(g.id)?.[i]?.value ?? 0) })) };
      }
    } catch (e) {
      if (my !== cmpSeq) return;
      cmp = { dim, dates: [], groups: [], error: errorText(e) };
    }
    setBusy(false);
    renderCompare();
  }

  // ---------------------------------------------------------------- labels
  /** First of a month shows the month, any other day its number. */
  function axisLabel(iso) {
    const [, m, d] = iso.split('-').map(Number);
    return d === 1 ? MON[m - 1] : String(d);
  }

  // ---------------------------------------------------------------- KPI picker
  /** The KPI name is a picker: the hub's KPIs first, then the tenant's other metrics. */
  function kpiPicker(crumb = null) {
    const list = hub.metrics || [];
    const opt = (m) => h('option', { value: m.id, selected: m.id === metricId }, m.label);
    const kpis = list.filter((m) => m.key), others = list.filter((m) => !m.key);
    return h('div', { class: 'an-kpi-name' },
      h('select', { class: 'an-kpi-pick', title: 'Change KPI', 'aria-label': 'KPI', onchange: (e) => switchKpi(e.target.value) },
        kpis.length ? h('optgroup', { label: 'KPIs' }, kpis.map(opt)) : null,
        others.length ? h('optgroup', { label: 'Other metrics' }, others.map(opt)) : null),
      crumb);
  }
  /** Another KPI under the same settings: range, aggregation, focal date, filters, breakdown, chart options. */
  function switchKpi(id) {
    const next = (hub.metrics || []).find((m) => m.id === id);
    if (!next || id === metricId) return;
    metricId = id;
    meta = next;
    history.replaceState({}, '', `/analytics/kpi/${encodeURIComponent(id)}${location.search}`);
    loaded = false;
    cmp = null;
    renderShell();
    if (S.tab === 'compare') loadCompare();
    else load();
  }

  // ---------------------------------------------------------------- shell
  const root = h('div', { class: 'an' });
  const body = h('div');
  mount(container, root);
  function setBusy(on) { root.classList.toggle('an-busy', !!on); }
  function setTab(tab) {
    if (S.tab === tab) return;
    S.tab = tab;
    setQuery({ tab });
    renderShell();
    if (tab === 'compare') loadCompare();
    else if (!loaded) load();
  }
  function renderShell() {
    mount(root,
      h('div', { class: 'an-hero' },
        h('div', { class: 'an-hero-left' }, h('div', { class: 'an-title' }, 'Analytics hub')),
        h('div', { class: 'an-tabs', role: 'tablist' }, [['overview', 'Overview'], ['compare', 'Compare']].map(([k, label]) => h('button', {
          type: 'button', role: 'tab', class: ['an-tab', S.tab === k && 'active'], 'aria-selected': String(S.tab === k), onclick: () => setTab(k),
        }, label)))),
      body);
    if (S.tab === 'overview') renderOverview();
    else renderCompare();
  }

  // ---------------------------------------------------------------- overview
  const els = {};
  const visible = () => (full.length ? full.slice(sel[0], sel[1] + 1) : []);
  function focalIdx() {
    if (!full.length) return -1;
    if (S.focal) { const i = full.findIndex((p) => p.date <= S.focal && S.focal <= p.to); if (i >= 0) return i; }
    return full.length - 1;
  }
  const showBreakdown = () => !!S.groupBy && !S.filters.some((f) => f.dim === S.groupBy);
  const filterLabel = (f) => `${dimLabel(f.dim)}: ${f.label}`;

  function renderOverview() {
    if (S.tab !== 'overview') return;
    els.head = h('section', { class: 'an-head' });
    els.toolbar = h('section', { class: 'an-toolbar' });
    els.drawer = h('aside', { class: ['an-drawer', S.drawer && 'open'] });
    els.legend = h('div', { class: 'an-legend' });
    els.chart = h('div', { class: 'an-chart' });
    mount(body, els.head, els.toolbar, h('section', { class: 'an-main' }, els.drawer, h('div', { class: 'an-chart-col' }, els.legend, els.chart)));
    renderHead();
    renderToolbar();
    renderDrawer();
    renderMain();
  }

  function renderHead() {
    if (!els.head) return;
    if (ctxError) return mount(els.head, h('div', { class: 'callout bad' }, `The engine could not read this KPI: ${ctxError}`));
    const fi = focalIdx();
    const cur = fi >= 0 ? full[fi].value : 0;
    // the change of the focal value since the start of the context
    const first = full.length ? full[0].value || 0 : 0;
    const change = isNum(cur) ? cur - first : 0;
    const kpiCol = h('div', { class: 'an-kpi-col' });
    const focalBtn = h('button', { class: 'an-link', type: 'button', title: 'Pick a date', 'data-pop-keep': '',
      onclick: () => openPopover(kpiCol, datePicker({ mode: 'single', granularity: aggOption(S.agg).gran, start: S.focal || S.dateFrom, end: S.focal || S.dateTo,
        onApply: (r) => { closePopover(); S.focal = r.start; renderHead(); renderMain(); renderDrawer(); }, onClose: closePopover }), 'focal') },
    S.focal ? longDate(S.focal) : fi >= 0 ? longDate(full[fi].date) : 'Pick a date', h('span', { class: 'an-caret' }, '▾'));
    mount(kpiCol,
      kpiPicker(S.filters.length ? h('span', { class: 'an-crumbf' }, ` › ${S.filters.map(filterLabel).join(', ')}`) : null),
      focalBtn,
      h('div', { class: 'an-value-row' },
        h('span', { class: 'an-value' }, fmt(cur)),
        change ? h('span', { class: ['an-trend', change > 0 ? 'up' : 'down'] }, `${change > 0 ? '▲' : '▼'} ${fmt(Math.abs(change))} (${Math.abs(pctFrom(cur, first))}%)`) : null));

    const navCol = h('div', { class: 'an-nav-col' });
    els.navRange = h('button', { class: 'an-link accent', type: 'button', title: 'Change date range', 'data-pop-keep': '',
      onclick: () => openPopover(navCol, datePicker({ mode: 'range', granularity: aggOption(S.agg).gran, start: S.dateFrom, end: S.dateTo,
        onApply: (r) => { closePopover(); S.dateFrom = r.start; S.dateTo = r.end; load(); }, onClose: closePopover }), 'range') });
    els.nav = h('div', { class: 'an-nav', role: 'slider', 'aria-label': 'Range', tabindex: '0' });
    els.stats = h('div', { class: 'an-stats' });
    mount(navCol,
      h('div', { class: 'an-nav-hd' }, els.navRange, aggSelect(S.agg, (v) => {
        S.agg = v;
        // a new granularity drops the picked range: the default span applies
        S.dateFrom = '';
        S.dateTo = '';
        load();
      })),
      els.nav, els.stats);
    mount(els.head, h('div', { class: 'an-head-grid' }, kpiCol, navCol));
    bindNav();
    renderSelection();
  }

  // ---- navigator
  let drag = null;
  function navGeom() {
    const W = Math.max(200, els.nav.clientWidth || 600);
    const n = full.length;
    return { W, n, X: (i) => (n <= 1 ? W / 2 : 10 + (i / (n - 1)) * (W - 20)), I: (x) => (n <= 1 ? 0 : Math.max(0, Math.min(n - 1, Math.round(((x - 10) / (W - 20)) * (n - 1))))) };
  }
  function drawNav() {
    if (!els.nav) return;
    const { W, n, X } = navGeom();
    if (!n) return mount(els.nav);
    const top = 4, bot = 54;
    const vals = full.map((p) => p.value);
    const finite = vals.filter(isNum);
    const mn = Math.min(0, ...finite), mx = Math.max(0, ...finite) || 1;
    const Y = (v) => bot - ((v - mn) / (mx - mn || 1)) * (bot - top - 4);
    const path = (from, to) => {
      let d = '', pen = false;
      for (let i = from; i <= to; i++) {
        if (!isNum(vals[i])) { pen = false; continue; }
        d += `${pen ? 'L' : 'M'}${X(i).toFixed(1)},${Y(vals[i]).toFixed(1)}`;
        pen = true;
      }
      return d;
    };
    const [a, b] = sel;
    const xa = X(a), xb = Math.max(X(b), xa + 2);
    const handle = (x, side) => `<g data-nv="${side}"><rect class="nv-handle" x="${(x - 5).toFixed(1)}" y="${top + 12}" width="10" height="28" rx="3"/><line class="nv-grip" x1="${(x - 1.5).toFixed(1)}" x2="${(x - 1.5).toFixed(1)}" y1="${top + 20}" y2="${top + 32}"/><line class="nv-grip" x1="${(x + 1.5).toFixed(1)}" x2="${(x + 1.5).toFixed(1)}" y1="${top + 20}" y2="${top + 32}"/></g>`;
    const la = shortDate(full[a].date), lb = shortDate(full[b].date);
    const labels = xb - xa < 90
      ? `<text class="nv-label" x="${Math.min(W - 2, Math.max(2, (xa + xb) / 2)).toFixed(1)}" y="68" text-anchor="${(xa + xb) / 2 > W - 70 ? 'end' : (xa + xb) / 2 < 70 ? 'start' : 'middle'}">${esc(a === b ? la : `${la} – ${lb}`)}</text>`
      : `<text class="nv-label" x="${Math.max(2, xa).toFixed(1)}" y="68" text-anchor="${xa < 40 ? 'start' : 'middle'}">${esc(la)}</text><text class="nv-label" x="${Math.min(W - 2, xb).toFixed(1)}" y="68" text-anchor="${xb > W - 40 ? 'end' : 'middle'}">${esc(lb)}</text>`;
    els.nav.innerHTML = `<svg viewBox="0 0 ${W} 72" preserveAspectRatio="none">`
      + `<rect class="nv-bg" x="0" y="${top - 2}" width="${W}" height="${bot - top + 4}" rx="4"/>`
      + `<path class="nv-line" d="${path(0, n - 1)}"/>`
      + `<rect class="nv-sel" data-nv="sel" x="${xa.toFixed(1)}" y="${top - 2}" width="${(xb - xa).toFixed(1)}" height="${bot - top + 4}"/>`
      + `<path class="nv-line sel" d="${path(a, b)}"/>`
      + handle(xa, 'l') + handle(xb, 'r') + labels + '</svg>';
    els.nav.setAttribute('aria-valuetext', `${la} to ${lb}`);
  }
  function bindNav() {
    els.nav.addEventListener('pointerdown', (e) => {
      if (!full.length) return;
      const r = els.nav.getBoundingClientRect();
      const g = navGeom();
      const part = e.target.closest?.('[data-nv]')?.dataset.nv || 'brush';
      drag = { part, i0: g.I(((e.clientX - r.left) / r.width) * g.W), a0: sel[0], b0: sel[1], left: r.left, width: r.width };
      els.nav.setPointerCapture(e.pointerId);
      if (part === 'brush') sel = [drag.i0, drag.i0];
      e.preventDefault();
      frame();
    });
    els.nav.addEventListener('pointermove', (e) => {
      if (!drag) return;
      const g = navGeom();
      const i = g.I(((e.clientX - drag.left) / drag.width) * g.W);
