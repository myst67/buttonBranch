// Pieces of the analytics hub page: its stylesheet, Platform X's aggregation list (what each one
// buckets by and which picker granularity it uses), and Platform X's date picker — a range picker
// (presets, two months side by side, start / end, Apply) or a single-date picker, both snapped to
// the aggregation's granularity (day, week, month, quarter or year).

import { h, mount } from './dom.js';
import { dayKey, startOfPeriod } from '/shared/time.js';

const CSS_HREF = '/assets/css/analytics.css';
export function ensureCss() {
  if (document.querySelector(`link[href="${CSS_HREF}"]`)) return;
  document.head.appendChild(h('link', { rel: 'stylesheet', href: CSS_HREF }));
}

/** Platform X's aggregations: the step a series moves in, the picker granularity, and where a to-date one starts. */
export const AGG_OPTIONS = [
  { value: 'total', label: 'Total (range)', bucket: 'day', gran: 'day' },
  { value: 'daily_sum', label: 'Daily · sum', bucket: 'day', gran: 'day' },
  { value: 'daily_avg', label: 'Daily · avg', bucket: 'day', gran: 'day' },
  { value: 'weekly_sum', label: 'Weekly · sum', bucket: 'week', gran: 'week' },
  { value: 'weekly_avg', label: 'Weekly · avg', bucket: 'week', gran: 'week' },
  { value: 'monthly_sum', label: 'Monthly · sum', bucket: 'month', gran: 'month' },
  { value: 'monthly_avg', label: 'Monthly · avg', bucket: 'month', gran: 'month' },
  { value: 'quarterly_sum', label: 'Quarterly · sum', bucket: 'quarter', gran: 'quarter' },
  { value: 'quarterly_avg', label: 'Quarterly · avg', bucket: 'quarter', gran: 'quarter' },
  { value: 'wtd_sum', label: 'Week-to-date · sum', bucket: 'day', gran: 'week', toDate: 'week' },
  { value: 'wtd_avg', label: 'Week-to-date · avg', bucket: 'day', gran: 'week', toDate: 'week' },
  { value: 'mtd_sum', label: 'Month-to-date · sum', bucket: 'day', gran: 'month', toDate: 'month' },
  { value: 'mtd_avg', label: 'Month-to-date · avg', bucket: 'day', gran: 'month', toDate: 'month' },
  { value: 'qtd_sum', label: 'Quarter-to-date · sum', bucket: 'week', gran: 'quarter', toDate: 'quarter' },
  { value: 'qtd_avg', label: 'Quarter-to-date · avg', bucket: 'week', gran: 'quarter', toDate: 'quarter' },
  { value: 'ytd_sum', label: 'Year-to-date · sum', bucket: 'month', gran: 'year', toDate: 'year' },
  { value: 'ytd_avg', label: 'Year-to-date · avg', bucket: 'month', gran: 'year', toDate: 'year' },
];
export const aggOption = (agg) => AGG_OPTIONS.find((o) => o.value === agg) || AGG_OPTIONS[1];

const ADJ = { day: 'daily', week: 'weekly', month: 'monthly', quarter: 'quarterly' };
const isNum = (v) => v !== null && v !== undefined && Number.isFinite(v);

/**
 * What the hub asks the engine for under an aggregation, and how foldSeries reshapes the answer.
 * The engine computes a step the same way for _sum and _avg (the mode only changes its one
 * scalar), so the hub folds the series itself:
 *   weekly / monthly / quarterly · sum   the step's own value
 *   weekly / monthly / quarterly · avg   the step's daily values, averaged (per day)
 *   daily · sum / avg                    the day's value (a day's average is the day)
 *   to-date · sum / avg                  the daily values summed / averaged (per day) from the
 *                                        start of each week, month, quarter or year: a running
 *                                        value that restarts, shown at the end of each step
 * Folds start from daily values, so a week that straddles a quarter never mixes two quarters.
 */
export function seriesPlan(agg) {
  const o = aggOption(agg);
  const avg = o.value.endsWith('_avg');
  if (o.toDate) return { agg: 'daily_sum', fold: 'todate', period: o.toDate, step: o.bucket, avg };
  if (avg && o.bucket !== 'day') return { agg: 'daily_sum', fold: 'step', step: o.bucket, avg };
  return { agg: `${ADJ[o.bucket]}_sum`, fold: null, avg };
}

const meanOf = (vals) => (vals.length ? vals.reduce((a, b) => a + b, 0) / vals.length : null);
/** Daily points grouped into steps (week, month …): each step dated from its start, valued by pick. */
function bySteps(points, step, tz, pick) {
  if (step === 'day') return points;
  const out = [];
  for (const p of points) {
    const k = startOfPeriod(p.s, step, tz);
    let cur = out[out.length - 1];
    if (!cur || cur.k !== k) out.push(cur = { k, s: k, date: dayKey(k, tz), to: p.to, pts: [] });
    cur.to = p.to;
    cur.pts.push(p);
  }
  return out.map(({ k, pts, ...p }) => ({ ...p, value: pick(pts) }));
}

/** Fold daily engine points ({ s, date, to, value }, oldest first) as a plan says. */
export function foldSeries(points, plan, tz) {
  if (!plan.fold) return points;
  if (plan.fold === 'step') return bySteps(points, plan.step, tz, (pts) => meanOf(pts.map((p) => p.value).filter(isNum)));
  let period = null, sum = 0, n = 0;
  const running = points.map((p) => {
    const k = startOfPeriod(p.s, plan.period, tz);
    if (k !== period) { period = k; sum = 0; n = 0; }
    if (isNum(p.value)) { sum += p.value; n += 1; }
    return { ...p, value: n ? (plan.avg ? sum / n : sum) : null };
  });
  return bySteps(running, plan.step, tz, (pts) => pts[pts.length - 1].value);
}

export function aggSelect(cur, onChange, attrs = {}) {
  return h('select', { class: 'an-sel', title: 'Aggregation', 'aria-label': 'Aggregation', ...attrs, onchange: (e) => onChange(e.target.value) },
    AGG_OPTIONS.map((o) => h('option', { value: o.value, selected: o.value === cur }, o.label)));
}

// ---------------------------------------------------------------- dates
const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
export const isoOf = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
export const parseIso = (s) => { const [y, m, d] = String(s).split('-').map(Number); return new Date(y, (m || 1) - 1, d || 1); };
export function shiftIso(iso, days) {
  const d = parseIso(iso);
  d.setDate(d.getDate() + days);
  return isoOf(d);
}
export const longDate = (iso) => (iso ? parseIso(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '');
export const shortDate = (iso) => (iso ? parseIso(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '');

function weekStart(d) {
  const x = new Date(d);
  x.setDate(x.getDate() - ((x.getDay() + 6) % 7));
  return x;
}
function isoWeek(d) {
  const t = new Date(Date.UTC(d.getFullYear(), d.getMonth(), d.getDate()));
  t.setUTCDate(t.getUTCDate() - ((t.getUTCDay() + 6) % 7) + 3);
  const firstThu = new Date(Date.UTC(t.getUTCFullYear(), 0, 4));
  firstThu.setUTCDate(firstThu.getUTCDate() - ((firstThu.getUTCDay() + 6) % 7) + 3);
  return 1 + Math.round((t - firstThu) / (7 * 86400000));
}
/** The span a picked date stands for at a granularity. */
function span(d, gran) {
  switch (gran) {
    case 'week': { const s = weekStart(d); const e = new Date(s); e.setDate(s.getDate() + 6); return { s, e }; }
    case 'month': return { s: new Date(d.getFullYear(), d.getMonth(), 1), e: new Date(d.getFullYear(), d.getMonth() + 1, 0) };
    case 'quarter': { const q = Math.floor(d.getMonth() / 3); return { s: new Date(d.getFullYear(), q * 3, 1), e: new Date(d.getFullYear(), q * 3 + 3, 0) }; }
    case 'year': return { s: new Date(d.getFullYear(), 0, 1), e: new Date(d.getFullYear(), 11, 31) };
    default: return { s: d, e: d };
  }
}
function floorTo(d, unit) {
  if (unit === 'year') return new Date(d.getFullYear(), 0, 1);
  if (unit === 'quarter') return new Date(d.getFullYear(), Math.floor(d.getMonth() / 3) * 3, 1);
  return new Date(d.getFullYear(), d.getMonth(), 1);
}

const PRESETS = [
  ['7d', '7 DAYS'], ['1m', '1 MONTH'], ['3m', '3 MONTHS'], ['6m', '6 MONTHS'], ['ytd', 'YTD'], ['1y', '1 YEAR'], ['all', 'ALL'], ['custom', 'CUSTOM'],
];

/**
 * Platform X's date picker. mode 'range': presets, two months (or month / quarter / year cells), start
 * and end, Cancel / Apply → onApply({ start, end }). mode 'single': one month; a click picks the
 * granularity's unit → onApply({ start, end }).
 */
export function datePicker({ mode = 'range', granularity = 'day', start = '', end = '', onApply, onClose }) {
  const st = { start, end, preset: 'custom' };
  const anchor = start ? parseIso(start) : new Date();
  let viewY = anchor.getFullYear(), viewM = anchor.getMonth();
  if (mode === 'single') {
    const { s, e } = span(anchor, granularity);
    st.start = isoOf(s);
    st.end = isoOf(e);
  }
  const el = h('div', { class: ['dp', mode === 'range' && 'dp-range'], role: 'dialog', 'aria-label': mode === 'range' ? 'Date range' : 'Date' });

  const commit = () => {
    if (!st.start || !st.end) return;
    const [s, e] = st.start <= st.end ? [st.start, st.end] : [st.end, st.start];
    onApply({ start: s, end: e });
  };
  const pick = (d) => {
    st.preset = 'custom';
    const { s, e } = span(d, granularity);
    if (mode === 'single') { st.start = isoOf(s); st.end = isoOf(e); commit(); return; }
    if (!st.start || st.end) { st.start = isoOf(s); st.end = ''; }
    else if (e < parseIso(st.start)) { st.end = st.start; st.start = isoOf(s); }
    else st.end = isoOf(e);
    draw();
  };
  const applyPreset = (key) => {
    st.preset = key;
    if (key === 'custom') { st.start = ''; st.end = ''; draw(); return; }
    const e = new Date();
    let s = new Date();
    if (key === '7d') s.setDate(e.getDate() - 6);
    else if (key === '1m') s.setMonth(e.getMonth() - 1);
    else if (key === '3m') s.setMonth(e.getMonth() - 3);
    else if (key === '6m') s.setMonth(e.getMonth() - 6);
    else if (key === '1y') s.setFullYear(e.getFullYear() - 1);
    else if (key === 'ytd') s = new Date(e.getFullYear(), 0, 1);
    else if (key === 'all') s.setFullYear(e.getFullYear() - 3);
    st.start = isoOf(span(s, granularity).s);
    st.end = isoOf(span(e, granularity).e);
    viewY = e.getFullYear();
    viewM = e.getMonth();
    draw();
  };
  const inRange = (iso) => st.start && st.end && iso >= st.start && iso <= st.end;
  const cellSel = (d, unit) => {
    if (!st.start) return false;
    const lo = floorTo(d, unit).getTime();
    const s = floorTo(parseIso(st.start), unit).getTime();
    const e = st.end ? floorTo(parseIso(st.end), unit).getTime() : null;
    return lo === s || lo === e || (e !== null && lo >= s && lo <= e);
  };
  const shiftMonth = (n) => {
    viewM += n;
    if (viewM < 0) { viewM = 11; viewY--; } else if (viewM > 11) { viewM = 0; viewY++; }
    draw();
  };
  const nav = (label, onClick) => h('button', { type: 'button', class: 'dp-nav', 'aria-label': label === '‹' ? 'Previous' : 'Next', onclick: onClick }, label);
  const ghost = () => h('span', { class: 'dp-nav dp-ghost' });

  function calendar(y, m, left) {
    const first = new Date(y, m, 1);
    const gridStart = new Date(y, m, 1 - ((first.getDay() + 6) % 7));
    const dual = mode === 'range';
    const rows = [];
    for (let w = 0; w < 6; w++) {
      const monday = new Date(gridStart.getFullYear(), gridStart.getMonth(), gridStart.getDate() + w * 7);
      const days = [];
      let weekSel = false;
      for (let k = 0; k < 7; k++) {
        const date = new Date(monday.getFullYear(), monday.getMonth(), monday.getDate() + k);
        const iso = isoOf(date);
        const inMonth = date.getMonth() === m;
        if (inRange(iso) || iso === st.start || iso === st.end) weekSel = true;
        const edge = inMonth && (iso === st.start || iso === st.end);
        days.push(h('button', { type: 'button', class: ['dp-day', !inMonth && 'out', inMonth && granularity !== 'week' && edge && 'sel', inMonth && inRange(iso) && 'in-range', edge && 'edge'], onclick: () => pick(date) }, String(date.getDate())));
      }
      rows.push(h('div', { class: ['dp-wk', granularity === 'week' && weekSel && 'wk-sel'] }, String(isoWeek(monday))), ...days);
    }
    return h('div', { class: 'dp-cal' },
      h('div', { class: 'dp-cal-hd' },
        left ? nav('‹', () => shiftMonth(-1)) : ghost(),
        h('span', { class: 'dp-cal-title' }, `${MON[m]} ${y}`),
        !left || !dual ? nav('›', () => shiftMonth(1)) : ghost()),
      h('div', { class: 'dp-grid' }, h('div', { class: 'dp-wk-h' }, 'Wk'), ['Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa', 'Su'].map((d) => h('div', { class: 'dp-dow' }, d)), rows));
  }

  function main() {
    if (granularity === 'day' || granularity === 'week') {
      const cals = [calendar(viewY, viewM, true)];
      if (mode === 'range') cals.push(calendar(viewM === 11 ? viewY + 1 : viewY, (viewM + 1) % 12, false));
      return h('div', { class: 'dp-cals' }, cals);
    }
    const yearHd = h('div', { class: 'dp-cal-hd' }, nav('‹', () => { viewY--; draw(); }), h('span', { class: 'dp-cal-title' }, String(viewY)), nav('›', () => { viewY++; draw(); }));
    if (granularity === 'month') {
      return h('div', { class: 'dp-cellsel' }, yearHd, h('div', { class: 'dp-cells c3' }, MON.map((mn, i) => h('button', { type: 'button', class: ['dp-cell', cellSel(new Date(viewY, i, 1), 'month') && 'sel'], onclick: () => pick(new Date(viewY, i, 1)) }, mn))));
    }
    if (granularity === 'quarter') {
      return h('div', { class: 'dp-cellsel' }, yearHd, h('div', { class: 'dp-cells c2' }, [0, 1, 2, 3].map((q) => h('button', { type: 'button', class: ['dp-cell', 'lg', cellSel(new Date(viewY, q * 3, 1), 'quarter') && 'sel'], onclick: () => pick(new Date(viewY, q * 3, 1)) }, `Q${q + 1}`, h('small', String(viewY))))));
    }
    const years = Array.from({ length: 12 }, (_, i) => viewY - 8 + i);
    return h('div', { class: 'dp-cellsel' }, h('div', { class: 'dp-cells c3' }, years.map((y) => h('button', { type: 'button', class: ['dp-cell', cellSel(new Date(y, 0, 1), 'year') && 'sel'], onclick: () => pick(new Date(y, 0, 1)) }, String(y)))));
  }

  function draw() {
    mount(el,
      mode === 'range' ? h('div', { class: 'dp-presets' }, PRESETS.map(([k, label]) => h('button', { type: 'button', class: ['dp-preset', st.preset === k && 'active'], onclick: () => applyPreset(k) }, label))) : null,
      h('div', { class: 'dp-main' },
        main(),
        mode === 'range' ? h('div', { class: 'dp-foot' },
          h('div', { class: 'dp-io' }, h('label', 'Start date'), h('div', { class: 'dp-io-val' }, st.start ? longDate(st.start) : '—')),
          h('div', { class: 'dp-io' }, h('label', 'End date'), h('div', { class: 'dp-io-val' }, st.end ? longDate(st.end) : '—')),
          h('div', { class: 'dp-foot-btns' },
            h('button', { type: 'button', class: 'dp-btn', onclick: () => onClose?.() }, 'Cancel'),
            h('button', { type: 'button', class: 'dp-btn primary', disabled: !st.start || !st.end, onclick: commit }, 'Apply'))) : null));
  }
  draw();
  return el;
}

/** One open popover at a time, closed by an outside click (an `[data-pop-keep]` element keeps it). */
let openPop = null;
function outside(e) {
  if (openPop && !openPop.el.contains(e.target) && !e.target.closest?.('[data-pop-keep]')) closePopover();
}
export function openPopover(host, el, cls = '') {
  closePopover();
  const wrap = h('div', { class: ['an-pop', cls] }, el);
  host.appendChild(wrap);
  openPop = { el: wrap };
  setTimeout(() => document.addEventListener('mousedown', outside), 0);
  return wrap;
}
export function closePopover() {
  if (openPop) openPop.el.remove();
  openPop = null;
  document.removeEventListener('mousedown', outside);
}
